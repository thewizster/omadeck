# Maintainer: Raymond Brady (github.com/thewizster)
pkgname=omadeck
pkgver=0.1.0
pkgrel=1
pkgdesc="Elgato Stream Deck for Omarchy: launch apps, run scripts, play sounds and open websites"
arch=('x86_64' 'aarch64')
url="https://github.com/thewizster/omadeck"
license=('MIT')
depends=('gtk4' 'libadwaita' 'systemd-libs' 'pipewire' 'fontconfig')
makedepends=('cargo' 'git')
optdepends=('uwsm: launch apps in their own systemd scope (Omarchy default)'
            'hyprland: Hyprland dispatcher actions')
options=('!debug')  # binaries are already stripped (release profile)
install=omadeck.install
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen -p omadeck-core
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/omadeck "$pkgdir/usr/bin/omadeck"
  install -Dm755 target/release/omadeckd "$pkgdir/usr/bin/omadeckd"
  install -Dm644 packaging/dev.omadeck.Omadeck.desktop "$pkgdir/usr/share/applications/dev.omadeck.Omadeck.desktop"
  install -Dm644 assets/dev.omadeck.Omadeck.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.omadeck.Omadeck.svg"
  sed 's|@BINDIR@|/usr/bin|' packaging/omadeckd.service | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/omadeckd.service"
  install -Dm644 packaging/70-omadeck.rules "$pkgdir/usr/lib/udev/rules.d/70-omadeck.rules"
  install -Dm644 examples/config.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
